a launchd and LaunchAgents.\\ncategory: devops\\n---\\n\\n# macOS LaunchAgent Management\\n\\nGuide for setting up, debugging, and maintaining macOS background services using `launchd` and `~/Library/LaunchAgents/`.\\n\\n## Standard Workflow\\n1. Create a `.plist` file in `~/Library/LaunchAgents/` with proper permissions (`644`).\\n2. Ensure the `EnvironmentVariables` dictionary explicitly defines `PATH` and required app-specific variables.\\n3. Load the agent: `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/<name>.plist`\\n4. Verify it's running: `lsof -iTCP:<port> -sTCP:LISTEN` or check launchctl domain.\\n\\n## Pitfalls\\n- **macOS Gatekeeper blocking scripts**: Direct execution of shell scri...","status":"ok","task_id":"20260617_100800_e0359a","tool_call_id":"call_0c3f09c177774212bd996775","tool_name":"skill_view","turn_id":"20260617_100800_e0359a:20260617_100800_e0359a:38df41a0"},"sessionId":"20260617_100800_e0359a","timestamp":"2026-06-17T15:16:42.474686+00:00"},"type":"raw"},"obs_mqi7shlx_53fcfade8463":{"observation":{"hookType":"post_tool_call","id":"obs_mqi7shlx_53fcfade8463","raw":{"args_preview":"{\"mode\":\"replace\",\"path\":\"/Users/davec/Library/LaunchAgents/ai.hermes.webui.plist\",\"old_string\":\"    <key>LimitLoadToSessionType</key>\\n    <array>\\n        <string>Aqua</string>\\n        <string>Background</string>\\n    </array>\\n\\n    <key>RunAtLoad</key>\\n    <true/>\\n\\n    <key>KeepAlive</key>\\n    <true/>\\n\\n    <key>StandardOutPath</key>\\n    <string>/Users/davec/.hermes/logs/webui.log</string>\\n\\n    <key>StandardErrorPath</key>\\n    <string>/Users/davec/.hermes/logs/webui.error.log</stri...","duration_ms":182,"error_message":null,"is_error":false,"result_preview":"{\"success\": true, \"diff\": \"--- a//Users/davec/Library/LaunchAgents/ai.hermes.webui.plist\\n+++ b//Users/davec/Library/LaunchAgents/ai.hermes.webui.plist\\n@@ -39,7 +39,24 @@\\n     <true/>\\n \\n     <key>KeepAlive</key>\\n-    <true/>\\n+    <dict>\\n+        <key>SuccessfulExit</key>\\n+        <false/>\\n+        <key>Crashed</key>\\n+        <true/>\\n+    </dict>\\n+\\n+    <key>ThrottleInterval</key>\\n+    <integer>30</integer>\\n+\\n+    <key>ExitTimeOut</key>\\n+    <integer>60</integer>\\n+\\n+    <key>SoftResourceLimits</key>\\n+    <dict>\\n+        <key>NumberOfFiles</key>\\n+        <integer>4096</integer>\\n+    </dict>\\n \\n     <key>StandardOutPath</key>\\n     <string>/Users/davec/.hermes/logs/webui.log</string>\\n\", \"files_modified\": [\"/Users/davec/Library/LaunchAgents/ai.hermes.webui.plist\"], \"lint\": {\"status\": \"skipped\", \"message\": \"No linter for .plist files\"}, \"resolved_path\": \"/Users/davec/Library/LaunchAgents/ai.hermes.webui.plist\"}","status":"ok","task_id":"20260617_100800_e0359a","tool_call_id":"call_e08b130ecf1e4e36bf81cf91","tool_name":"patch","turn_id":"20260617_100800_e0359a:20260617_100800_e0359a:38df41a0"},"sessionId":"20260617_100800_e0359a","timestamp":"2026-06-17T15:17:08.514024+00:00"},"type":"raw"},"obs_mqi7sul9_b809f7a8ef03":{"observation":{"hookType":"post_tool_call","id":"obs_mqi7sul9_b809f7a8ef03","raw":{"args_preview":"{\"path\":\"/Users/davec/.hermes/scripts/webui-watchdog.sh\",\"content\":\"#!/usr/bin/env bash\\n# WebUI watchdog \\u2014 checks if port 8787 is healthy and restarts if dead.\\n# Runs every 5 minutes via ai.hermes.webui-watchdog.plist.\\nset -euo pipefail\\n\\nPORT=8787\\nLABEL=\\\"ai.hermes.webui\\\"\\nLOG=\\\"$HOME/.hermes/logs/webui-watchdog.log\\\"\\nHEALTH_URL=\\\"http://127.0.0.1:${PORT}/health\\\"\\n\\ntimestamp() { date \\\"+%Y-%m-%d %H:%M:%S\\\"; }\\n\\n# Check if anything is listening on the port\\nif lsof -iTCP:${PORT} -...","duration_ms":920,"error_message":null,"is_error":false,"result_preview":"{\"bytes_written\": 1491, \"dirs_created\": true, \"lint\": {\"status\": \"skipped\", \"message\": \"No linter for .sh files\"}, \"resolved_path\": \"/Users/davec/.hermes/scripts/webui-watchdog.sh\", \"files_modified\": [\"/Users/davec/.hermes/scripts/webui-watchdog.sh\"]}","status":"ok","task_id":"20260617_100800_e0359a","tool_call_id":"call_d1daf7d4011e46a1bbfb59bd","tool_name":"write_file","turn_id":"20260617_100800_e0359a:20260617_100800_e0359a:38df41a0"},"sessionId":"20260617_100800_e0359a","timestamp":"2026-06-17T15:17:25.336770+00:00"},"type":"raw"},"obs_mqi7v34z_f1c31a66031f":{"observation":{"hookType":"post_tool_call","id":"obs_mqi7v34z_f1c31a66031f","raw":{"args_preview":"{\"action\":\"patch\",\"old_string\":\"- **Port conflicts on reload**: Old daemon processes often hold the port after a failed reload. Always kill existing processes (`pkill -f <process_name>`) and verify the port is free (`lsof -iTCP:<PORT> -sTCP:LISTEN`) *before* running `launchctl bootstrap`.\",\"new_string\":\"- **Port conflicts on reload**: Old daemon processes often hold the port after a failed reload. Always kill existing processes (`pkill -f <process_name>`) and verify the port is free (`lsof -iTCP...","duration_ms":44,"error_message":"Skill '' not found in active profile 'default'. Use skills_list() to see available skills.","is_error":true,"result_preview":"{\"success\": false, \"error\": \"Skill '' not found in active profile 'default'. Use skills_list() to see available skills.\"}","status":"error","task_id":"d178f905-e452-4c64-b1b3-6b4af8da0ef6","tool_call_id":"call_b66b2a5fec2f4c6da53da122","tool_name":"skill_manage","turn_id":"20260617_100800_e0359a:d178f905-e452-4c64-b1b3-6b4af8da0ef6:fd302668"},"sessionId":"20260617_100800_e0359a","timestamp":"2026-06-17T15:19:09.728821+00:00"},"type":"raw"},"obs_mqi7v6m7_375432bdff53":{"observation":{"hookType":"post_tool_call","id":"obs_mqi7v6m7_375432bdff53","raw":{"args_preview":"{\"category\":\"devops\"}","duration_ms":37,"error_message":null,"is_error":false,"result_preview":"{\"success\": true, \"skills\": [{\"name\": \"hermes-agentmemory-integration\", \"description\": \"Patterns for integrating AgentMemory session tracking and auto-observation into Hermes Agen