iption\": \"Drive the user's desktop in the background — clicking, typing,\\nscrolling, dragging — without stealing the cursor, keyboard focus,\\nor switching virtual desktops / Spaces. Cross-platform: macOS,\\nWindows, Linux. Works with any tool-capable model. Load this skill\\nwhenever the `computer_use` tool is available.\\n\", \"category\": null}, {\"name\": \"bettertouchtool\", \"description\": \"BetterTouchTool (BTT) desktop automation — MCP server interaction, AI assistant configuration, trigger/action management, background computer use, and BTT data file locations.\", \"category\": \"apple\"}, {\"name\": \"macos-integrations\", \"description\": \"Apple/macOS local integrations: iMessage/SMS, Notes, Reminders, FindMy device tracking. Plus macos-launchd for background services and computer-use for desktop automation.\", \"category\": \"apple\"}, {\"name\": \"agentmemory-hermes-integration\", \"description\": \"Troubleshooting and rules for AgentMemory integrat...","status":"ok","task_id":"8126e739-e83e-42d2-824a-87f679d7f1d8","tool_call_id":"call_function_tzkuhmpx6fzw_1","tool_name":"skills_list","turn_id":"20260701_040209_4ee2de:8126e739-e83e-42d2-824a-87f679d7f1d8:b8749413"},"sessionId":"20260701_040209_4ee2de","timestamp":"2026-07-01T19:13:03.764762+00:00"},"type":"raw"},"obs_mr2gdygz_c770e7ac5dbe":{"observation":{"hookType":"post_tool_call","id":"obs_mr2gdygz_c770e7ac5dbe","raw":{"args_preview":"{\"name\":\"distributed-inference\"}","duration_ms":19,"error_message":null,"is_error":false,"result_preview":"{\"success\": true, \"name\": \"distributed-inference\", \"description\": \"Set up, configure, and troubleshoot distributed AI inference clusters across multiple Macs (EXO, etc). Peer discovery, zenoh transport, multiaddr format, static peer config, dashboard access.\", \"tags\": [], \"related_skills\": [], \"content\": \"---\\nname: distributed-inference\\ndescription: \\\"Set up, configure, and troubleshoot distributed AI inference clusters across multiple Macs (EXO, etc). Peer discovery, zenoh transport, multiaddr format, static peer config, dashboard access.\\\"\\ntriggers:\\n  - \\\"exo cluster\\\"\\n  - \\\"distributed inference\\\"\\n  - \\\"multi-node AI\\\"\\n  - \\\"zenoh peer\\\"\\n  - \\\"static peers\\\"\\n  - \\\"cross-subnet discovery\\\"\\n  - \\\"AI cluster not finding nodes\\\"\\n---\\n\\n# Distributed Inference Cluster Setup & Troubleshooting\\n\\n## Coverage\\n\\nThis skill covers setting up and debugging multi-machine AI inference clusters, primarily EXO (exo-explore/exo). It addresses peer discovery, transport layer configuratio...","status":"ok","task_id":"8126e739-e83e-42d2-824a-87f679d7f1d8","tool_call_id":"call_function_0r5ifdq9x31q_1","tool_name":"skill_view","turn_id":"20260701_040209_4ee2de:8126e739-e83e-42d2-824a-87f679d7f1d8:b8749413"},"sessionId":"20260701_040209_4ee2de","timestamp":"2026-07-01T19:13:10.593167+00:00"},"type":"raw"},"obs_mr2gem51_3c232eb51622":{"observation":{"hookType":"post_tool_call","id":"obs_mr2gem51_3c232eb51622","raw":{"args_preview":"{\"mode\":\"replace\",\"path\":\"/Users/davec/.hermes/skills/research/distributed-inference/SKILL.md\",\"old_string\":\"## EXO Architecture\\n\\n- Uses **zenoh** for peer-to-peer mesh communication and discovery (not libp2p in current builds, though binary may contain both names).\\n- Each node runs a Rust binary (`exo`) plus a Swift wrapper app (`EXO.app`) on macOS.\\n- Discovery can be automatic via mDNS or explicit via **static peers** for cross-subnet setups.\\n- The app exposes a web dashboard (port varies...","duration_ms":0,"error_message":"Background review denied non-whitelisted tool: patch. Only memory/skill tools are allowed.","is_error":true,"result_preview":"{\"error\": \"Background review denied non-whitelisted tool: patch. Only memory/skill tools are allowed.\"}","status":"blocked","task_id":"8126e739-e83e-42d2-824a-87f679d7f1d8","tool_call_id":"call_function_xcby8i2pstt9_1","tool_name":"patch","turn_id":"20260701_04